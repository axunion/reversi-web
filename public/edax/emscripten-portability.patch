diff --git a/src/event.c b/src/event.c
index 7da3253..c7b041b 100644
--- a/src/event.c
+++ b/src/event.c
@@ -130,6 +130,32 @@ void event_add_message(Event *event, char *message)
  * @param cmd Command.
  * @param param Command's parameters.
  */
+#ifdef __EMSCRIPTEN__
+// Emscripten build without -pthread has no real thrd_create concurrency, so
+// the separate stdin-reader thread this file normally relies on never runs
+// and the condition-variable wait below blocks forever. This build only
+// drives Edax through a scripted, non-interactive command sequence (see
+// src/ai/edax.worker.ts), so reading stdin synchronously on the same thread
+// - as ui_read_input's reader thread would have done - is equivalent for
+// that use case and avoids needing real threads.
+void event_wait(Event *event, char **cmd, char **param)
+{
+	(void) event;
+	int n;
+	char *message = string_read_line(stdin);
+
+	if (message == NULL) message = string_duplicate("quit");
+
+	free(*cmd);
+	free(*param);
+
+	n = strlen(message);
+	*cmd = (char*) malloc(n + 1);
+	*param = (char*) malloc(n + 1);
+	parse_command(message, *cmd, *param, n);
+	free(message);
+}
+#else
 void event_wait(Event *event, char **cmd, char **param)
 {
 	int n;
@@ -152,6 +178,7 @@ void event_wait(Event *event, char **cmd, char **param)
 	parse_command(message, *cmd, *param, n);
 	free(message);
 }
+#endif
 
 void event_wait_enter(Event *event)
 {
